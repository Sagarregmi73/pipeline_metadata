# PostgreSQL Configuration
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow Configuration
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Database Connection
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://airflow:airflow@postgres:5432/airflow

# Celery Configuration
AIRFLOW__CELERY__BROKER_URL=amqp://guest:guest@rabbitmq:5672//
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@postgres:5432/airflow

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Watchdog Configuration
INCOMING_FOLDER=/app/data/incoming
REJECTED_FOLDER=/app/data/rejected
ARCHIVE_FOLDER=/app/data/archive

# Add your custom configurations below
# DATABRICKS_HOST=your_databricks_instance
# DATABRICKS_TOKEN=your_token
# DATABRICKS_CLUSTER_ID=your_cluster_id
